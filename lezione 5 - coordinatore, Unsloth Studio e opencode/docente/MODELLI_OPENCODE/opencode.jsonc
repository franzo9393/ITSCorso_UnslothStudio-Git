// Da mettere nella cartella noleggio della VM. Senza questo file la modalità Build
// di opencode scrive nella cartella di lavoro senza chiedere, anche con la shell (documentazione degli agenti).
// Non provato con la versione installata nella VM.
{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    }
  }
}
